# Скопіюйте в .env і за потреби змініть. Усі змінні необов'язкові.

# Пароль адміністратора. Якщо не задано — генерується при першому запуску й
# записується в data/FIRST_RUN.txt (разом із першим API-ключем BAS).
# HUB_ADMIN_PASSWORD=

# Публічна адреса (для підказок у панелі та FIRST_RUN.txt)
HUB_PUBLIC_URL=https://hotmail.vibecods.xyz

# Порт на хості (контейнер слухає 8080, назовні лише 127.0.0.1)
HOST_HTTP_PORT=14010

# Скільки денних копій mailboxes-YYYYMMDD.txt зберігати в data/backups (0 — вимкнути)
# HUB_BACKUP_KEEP=7

# Таймаут з'єднань із поштою, с
# HUB_PROVIDER_TIMEOUT=20

# Максимум одночасних IMAP-з'єднань
# HUB_MAX_CONNECTIONS=12
